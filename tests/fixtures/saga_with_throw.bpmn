<?xml version="1.0" encoding="UTF-8"?>
<!--
  Saga with a compensate end event. Contrast with saga.bpmn:

    saga.bpmn          : the boundary event is itself the failure
                         alternative; charge_card either succeeds or
                         the boundary fires from the same input place.
    saga_with_throw.bpmn (this file): charge_card always succeeds first,
                         then a downstream XOR routes either to normal
                         completion or to a compensate end event. The
                         end event consumes the completion marker
                         produced by charge_card and triggers the
                         refund handler.

  This is the real-BPMN "compensate a completed task after a later
  thrown compensation event" pattern, simplified to one task and one
  handler.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="p_saga_throw" isExecutable="true">
    <startEvent id="start"/>
    <task id="charge_card" name="Charge card"/>
    <exclusiveGateway id="check" name="Validate"/>
    <endEvent id="end_ok"/>
    <endEvent id="trigger_compensate" name="Compensation throw">
      <compensateEventDefinition/>
    </endEvent>
    <task id="refund_card" isForCompensation="true" name="Refund card"/>
    <boundaryEvent id="bnd_charge" attachedToRef="charge_card">
      <compensateEventDefinition/>
    </boundaryEvent>
    <endEvent id="end_compensated"/>

    <sequenceFlow id="f_start" sourceRef="start" targetRef="charge_card"/>
    <sequenceFlow id="f_charge_check" sourceRef="charge_card" targetRef="check"/>
    <sequenceFlow id="f_ok" sourceRef="check" targetRef="end_ok"/>
    <sequenceFlow id="f_to_throw" sourceRef="check" targetRef="trigger_compensate"/>
    <sequenceFlow id="f_refund_done" sourceRef="refund_card" targetRef="end_compensated"/>

    <association id="assoc_charge" associationDirection="One"
                 sourceRef="bnd_charge" targetRef="refund_card"/>
  </process>
</definitions>
